+let measurement_export invariant properties =
+  match Sys.getenv_opt "KIND2_MEASUREMENT_DIR" with
+  | None -> ()
+  | Some directory ->
+    incr measurement_export_index;
+    let clauses = List.map (fun c ->
+      let literals = C.literals_of_clause c in
+      `Assoc [("id", `Int (C.id_of_clause c));
+              ("literal_count", `Int (List.length literals));
+              ("literal_ast_sum", `Int (List.fold_left
+                 (fun n l -> n + literal_ast_complexity l) 0 literals));
+              ("clause", measurement_term (C.term_of_clause c));
+              ("literals", `List (List.map measurement_term literals))])
+      !measurement_support in
+    let certificate = Term.mk_and (invariant :: properties) in
+    Yojson.Basic.to_file
+      (Filename.concat directory
+        (Printf.sprintf "invariant_%03d.json" !measurement_export_index))
+      (`Assoc [("schema", `String "ic3-final-support-v1");
+               ("support_clauses", `List clauses);
+               ("support_term", measurement_term invariant);
+               ("properties", `List (List.map measurement_term properties));
+               ("certificate_term", measurement_term certificate);
+               ("indgen_calls", `Int !measurement_indgen_calls);
+               ("indgen_initial_queries", `Int !measurement_initial_queries);
